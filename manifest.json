{
  "manifest_version": 3,
  "name": "Braided Extension",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity" 
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Click to view"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/my-logo.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "oauth2": {
    "client_id": "447638571326-9tasmp33u4fb5rlnp4ru20gqn39ak679.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile" 
    ]
  }
}
